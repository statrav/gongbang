---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import LogList from '../components/LogList.astro';
import { getProjects, getLogs } from '../lib/content';
import { url } from '../lib/url';

const projects = await getProjects();
// 홈에는 최근에 시작한 순서로 4개만 (작업 중·완성 섞어서). 전체는 프로젝트 목록에
const recent = [...projects].sort((a, b) => b.data.startedAt.getTime() - a.data.startedAt.getTime()).slice(0, 4);
const logs = (await getLogs()).slice(0, 8);
const projectTitles = Object.fromEntries(projects.map((p) => [p.id, p.data.title]));
---

<Base>
  <div class="container home">
    <section class="hero">
      <h1>퇴근 후<br />공방</h1>
      <!-- 넓은 화면은 한 줄, 좁은 화면은 쉼표 뒤에서만 줄을 바꾼다 -->
      <p><span>퇴근하고 만드는 작은 도구들과,</span> <span>만들면서 알게 된 것들을 적어 둡니다.</span></p>
    </section>

    {recent.length > 0 && (
      <section class="projects" aria-labelledby="projects-title">
        <div class="section-head">
          <h2 id="projects-title">프로젝트</h2>
          <a href={url('/projects/')}>더보기 ›</a>
        </div>
        <div class="project-grid">
          {recent.map((p) => <ProjectCard project={p} compact />)}
        </div>
      </section>
    )}

    <section class="logs" aria-labelledby="logs-title">
      <div class="section-head">
        <h2 id="logs-title">제작기</h2>
        {logs.length > 0 && <a href={url('/logs/')}>더보기 ›</a>}
      </div>
      <LogList logs={logs} projectTitles={projectTitles} />
    </section>
  </div>
</Base>

<style>
  .home { display: grid; gap: var(--space-2xl); padding-top: var(--space-xl); }
  .hero h1 {
    font-size: var(--text-display);
    line-height: 1.05;
    letter-spacing: -0.02em;
    overflow-wrap: anywhere;
  }
  .hero p { margin: var(--space-md) 0 0; color: var(--color-graphite); font-size: var(--text-lg); line-height: 1.6; }
  .hero p span { display: inline-block; text-wrap: balance; }
  .projects, .logs { max-width: 42rem; }
  .project-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-sm); }
  .section-head { display: flex; justify-content: space-between; align-items: baseline; gap: var(--space-md); margin-bottom: var(--space-sm); }
  .section-head h2 { font-size: var(--text-xl); }
  .section-head a { font-size: var(--text-sm); white-space: nowrap; }
</style>
