---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getProjects } from '../../lib/content';

const projects = await getProjects();
---

<Base title="프로젝트" description="퇴근 후에 만들고 있는 사이드 프로젝트 목록">
  <div class="container page">
    <h1>프로젝트</h1>
    <p class="muted lede">퇴근 후에 만들고 있는 것들이에요. 직접 쓰려고 시작해서, 남도 쓸 수 있게 다듬는 중입니다.</p>
    <div class="grid">
      {projects.map((p) => <ProjectCard project={p} />)}
    </div>
  </div>
</Base>

<style>
  .page { padding-top: var(--space-xl); }
  h1 { font-size: var(--text-2xl); }
  .lede { margin: var(--space-xs) 0 var(--space-xl); max-width: 34rem; }
  .grid { display: grid; gap: var(--space-lg); grid-template-columns: minmax(0, 1fr); }
</style>
