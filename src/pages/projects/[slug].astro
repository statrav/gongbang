---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import LogList from '../../components/LogList.astro';
import { getProjects, getLogs, STATUS_LABEL } from '../../lib/content';
import { url, formatDateLong } from '../../lib/url';
import '../../styles/prose.css';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const logs = (await getLogs()).filter((l) => l.data.project.id === project.id);
const { title, note, summary, status, startedAt } = project.data;
---

<Base title={title} description={summary}>
  <div class="container page">
    <nav class="crumbs" aria-label="현재 위치">
      <a href={url('/projects/')}>프로젝트</a> <span aria-hidden="true">/</span> <span>{title}</span>
    </nav>
    <header>
      <h1>{title}{note && <small>({note})</small>}</h1>
      <p class="summary">{summary}</p>
      <dl class="facts">
        <div><dt>상태</dt><dd>{STATUS_LABEL[status]}</dd></div>
        <div><dt>시작</dt><dd>{formatDateLong(startedAt)}</dd></div>
        <div><dt>제작기</dt><dd>{logs.length}편</dd></div>
      </dl>
    </header>

    <article class="sheet prose">
      <Content />
    </article>

    <section class="logs" aria-labelledby="logs-title">
      <h2 id="logs-title">이 프로젝트의 제작기</h2>
      <LogList logs={logs} empty="이 프로젝트의 첫 제작기를 쓰는 중이에요." />
    </section>
  </div>
</Base>

<style>
  .page { padding-top: var(--space-lg); display: grid; gap: var(--space-xl); }
  .crumbs { font-size: var(--text-sm); color: var(--color-graphite); }
  h1 { font-size: var(--text-2xl); }
  h1 small {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 400;
    color: var(--color-graphite);
    margin-left: var(--space-xs);
    white-space: nowrap;
  }
  .summary { margin: var(--space-xs) 0 var(--space-md); max-width: 34rem; color: var(--color-graphite); font-size: var(--text-lg); line-height: 1.6; }
  .facts { display: flex; flex-wrap: wrap; gap: var(--space-xs) var(--space-xl); margin: 0; font-size: var(--text-sm); }
  .facts div { display: flex; gap: var(--space-xs); }
  .facts dt { color: var(--color-graphite); }
  .facts dd { margin: 0; font-weight: 500; font-variant-numeric: tabular-nums; }
  .logs { max-width: 42rem; }
  .logs h2 { font-size: var(--text-xl); margin-bottom: var(--space-sm); }
</style>
