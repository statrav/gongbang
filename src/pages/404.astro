---
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';
---

<Base title="페이지를 찾을 수 없어요">
  <div class="container page">
    <h1>이 주소에는 아무것도 없어요</h1>
    <p class="muted">주소가 바뀌었거나 아직 쓰지 않은 글이에요. <a href={url('/logs/')}>제작기 목록</a>이나 <a href={url('/')}>첫 화면</a>에서 찾아보세요.</p>
  </div>
</Base>

<style>
  .page { padding-top: var(--space-2xl); }
  h1 { font-size: var(--text-2xl); }
  p { max-width: 34rem; }
</style>
