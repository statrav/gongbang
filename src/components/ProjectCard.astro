---
import type { CollectionEntry } from 'astro:content';
import { url } from '../lib/url';
import { STATUS_LABEL } from '../lib/content';

interface Props {
  project: CollectionEntry<'projects'>;
  label?: string;
  /** 홈의 두 칸 배치용: 카드를 줄이고 소개는 세 줄까지 */
  compact?: boolean;
}

const { project, label, compact = false } = Astro.props;
const { title, note, summary, status, pinned } = project.data;
---

<article class:list={['card', { compact, pinned }]}>
  {pinned && (
    <span class="pin" role="img" aria-label="고정됨">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 17v5" /><path d="M9 10.76a2 2 0 0 1-1.11 1.79l-1.78.9A2 2 0 0 0 5 15.24V16a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-.76a2 2 0 0 0-1.11-1.79l-1.78-.9A2 2 0 0 1 15 10.76V7a1 1 0 0 1 1-1 2 2 0 0 0 0-4H8a2 2 0 0 0 0 4 1 1 0 0 1 1 1z" /></svg>
    </span>
  )}
  <p class:list={['label', { muted: status !== 'active' }]}>{label ?? STATUS_LABEL[status]}</p>
  <h3>
    <a href={url(`/projects/${project.id}/`)}>{title}</a>
    {note && <small>({note})</small>}
  </h3>
  <p class="summary">{summary}</p>
</article>

<style>
  .card {
    position: relative;
    background: var(--color-sheet);
    border: var(--rule) solid var(--color-ink);
    padding: var(--space-md) var(--space-lg) var(--space-lg);
    transition: transform var(--dur-press) var(--ease-out);
  }
  .card:has(a:active) { transform: scale(0.99); }
  .label { margin: 0; font-size: var(--text-sm); font-weight: 600; color: var(--color-accent); }
  /* 완성·쉬는 중은 연필색: 작업 중인 것만 파란 색연필로 */
  .label.muted { color: var(--color-graphite); }
  h3 { font-size: var(--text-xl); margin-block: var(--space-2xs) var(--space-xs); }
  h3 a { color: var(--color-ink); text-decoration: none; }
  /* 카드 전체를 누를 수 있게 */
  h3 a::after { content: ''; position: absolute; inset: 0; }
  h3 a:hover { text-decoration: underline; text-decoration-thickness: 2px; }
  .card:has(a:focus-visible) { outline: 2px solid var(--color-focus); outline-offset: 3px; }
  h3 a:focus-visible { outline: none; }
  small {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 400;
    color: var(--color-graphite);
    margin-left: var(--space-2xs);
    white-space: nowrap;
  }
  .summary { margin: 0; color: var(--color-graphite); }
  /* 고정한 카드: 오른쪽 위 모서리에 연필색 압정 */
  .pin { position: absolute; top: var(--space-md); right: var(--space-md); line-height: 0; color: var(--color-graphite); }
  .pin svg { width: var(--text-base); height: var(--text-base); fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .pinned .label { padding-right: var(--space-lg); }

  .compact { padding: var(--space-sm) var(--space-sm) var(--space-md); min-width: 0; }
  .compact h3 { font-size: var(--text-lg); line-height: 1.3; }
  .compact small { white-space: normal; }
  .compact .pin { top: var(--space-sm); right: var(--space-sm); }
  .compact .pin svg { width: var(--text-sm); height: var(--text-sm); }
  .compact .summary {
    font-size: var(--text-sm);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  @media (prefers-reduced-motion: reduce) { .card { transition: none; } .card:has(a:active) { transform: none; } }
</style>
