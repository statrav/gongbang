---
import { SITE } from '../lib/site';
import { url } from '../lib/url';
---

<footer class="container">
  <div class="site-footer">
    <p>{SITE.name}에서 만든 것과 만드는 과정을 기록합니다.</p>
    <ul>
      <li><a href={SITE.github}>GitHub</a></li>
      <li><a href={url('/rss.xml')}>RSS 구독</a></li>
    </ul>
  </div>
</footer>

<style>
  footer { margin-top: var(--space-2xl); }
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-xs) var(--space-lg);
    padding-block: var(--space-lg) var(--space-xl);
    border-top: var(--rule) solid var(--color-ink);
    font-size: var(--text-sm);
    color: var(--color-graphite);
  }
  p { margin: 0; }
  ul { display: flex; gap: var(--space-lg); list-style: none; margin: 0; padding: 0; }
  a { white-space: nowrap; }
</style>
